# Frontend environment configuration.
# Copy this file to .env.local and edit for your local setup.
# .env.local is gitignored — never commit real values.

# Set to 'true' to wire all API calls to the real FastAPI backend.
# Set to 'false' (or leave unset) to run fully on in-memory mock data.
#
# When switching to real mode, ensure the backend is running on
# http://localhost:8000 (or update the proxy target in vite.config.js).
#
# // HOOK FOR REAL API: flip this flag to enable live backend integration.
VITE_USE_REAL_API=false

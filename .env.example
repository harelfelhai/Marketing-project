# =============================================================================
# .env.example — Environment variable reference for local development.
#
# Copy this file to `.env` and adjust values as needed:
#     cp .env.example .env
#
# NEVER commit `.env` to version control — it may contain secrets.
# This file (.env.example) is safe to commit; it contains only placeholders.
# =============================================================================

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------

# SQLAlchemy-compatible connection string.
# Default: local SQLite file — suitable for development only.
# Internal deployment: replace with a production DSN, e.g.:
#   DATABASE_URL=postgresql+psycopg2://user:password@host:5432/dbname
DATABASE_URL=sqlite:///./app.db

# -----------------------------------------------------------------------------
# Injectable Module Paths  (THE CORE INJECTION MECHANISM)
# -----------------------------------------------------------------------------
# Each variable below tells the application which Python module to load
# for a given pipeline stage. The module must be importable from PYTHONPATH
# and must export the class named in dependencies.py.
#
# To inject a proprietary internal module:
#   1. Place your module on the server's PYTHONPATH.
#   2. Change the value below to the dotted path of your module.
#   3. Restart the application — no code changes required.

# Stage 1: Lead Ingestion
# Module must export a class named `IngestionEngine`
# that subclasses `interfaces.ingestion.BaseIngestionEngine`.
INGESTION_MODULE=modules.mock_ingestion

# Stage 2: Campaign Dispatch
# Module must export a class named `CampaignDispatcher`
# that subclasses `interfaces.dispatcher.BaseCampaignDispatcher`.
DISPATCHER_MODULE=modules.mock_dispatcher

# Stage 3: Feedback / Conversion Checking
# Module must export a class named `FeedbackChecker`
# that subclasses `interfaces.feedback.BaseFeedbackChecker`.
FEEDBACK_MODULE=modules.mock_feedback

# -----------------------------------------------------------------------------
# Scheduler Intervals
# -----------------------------------------------------------------------------

# How often (in seconds) the automated ingestion background job runs.
INGESTION_INTERVAL_SECONDS=60

# How often (in seconds) the feedback/conversion-check background job runs.
FEEDBACK_INTERVAL_SECONDS=120

# --- Database ---
DATABASE_URL=sqlite:///./app.db

# --- Injectable Module Paths ---
# Override these to swap in internal implementations without changing source code
INGESTION_MODULE=modules.mock_ingestion
DISPATCHER_MODULE=modules.mock_dispatcher
FEEDBACK_MODULE=modules.mock_feedback

# --- Scheduler Intervals ---
INGESTION_INTERVAL_SECONDS=60
FEEDBACK_INTERVAL_SECONDS=120
